{
  "name": "agent-status-tiles",
  "version": "0.1.0",
  "description": "A local macOS companion for AI agent session status.",
  "author": "Alex Braun",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-hook-helper.mjs --arch host --if-stale --optional && electron-vite dev",
    "start": "node scripts/build-hook-helper.mjs --arch host --if-stale --optional && electron-vite preview",
    "build": "electron-vite build",
    "build:hook-helper": "node scripts/build-hook-helper.mjs",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,html}' 'scripts/**/*.{d.mts,js,mjs,ts}' 'tests/**/*.{ts,tsx}' '*.{js,mjs,ts,json,yaml,yml}' '.github/**/*.{yml,yaml}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,html}' 'scripts/**/*.{d.mts,js,mjs,ts}' 'tests/**/*.{ts,tsx}' '*.{js,mjs,ts,json,yaml,yml}' '.github/**/*.{yml,yaml}'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "pack": "pnpm build && pnpm build:hook-helper && electron-builder --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.alxbra.agent-status-tiles",
    "productName": "Agent Status Tiles",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "beforePack": "./scripts/validate-hook-helper-pack.mjs",
    "mac": {
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "build/hook-helper",
          "to": "hook-helper",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7"
  }
}
